{
  "name": "@kms/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn src/main.ts",
    "lint": "eslint src --ext .ts",
    "test:unit": "jest --passWithNoTests",
    "test:integration": "jest --passWithNoTests --config jest.integration.config.js"
  },
  "dependencies": {
    "@kms/data": "workspace:*",
    "@kms/config": "workspace:*",
    "@kms/storage": "workspace:*",
    "@kms/ai-providers": "workspace:*",
    "@kms/parsing": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/mongoose": "^10.1.0",
    "mongoose": "^8.8.0",
    "bullmq": "^5.28.0",
    "nestjs-cls": "^4.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "jszip": "^3.10.1",
    "mongodb-memory-server": "^10.1.2",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0"
  }
