# Shared across apps/api, apps/portal-api (each loads its own copy of this file).
# Copy to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

NODE_ENV=development

# apps/api listens on 3000, apps/portal-api on 3100 by default if PORT is unset.
# apps/web's dev server uses `next dev -p 3010` directly, not this var.
PORT=3000

# MongoDB Atlas (or local mongod for dev). Falls back to mongodb://localhost:27017/kms if unset.
MONGO_URI=mongodb://localhost:27017/kms

# Redis used for sessions/caching (ADR-0004, ADR-0005). Falls back to localhost if unset.
REDIS_APP_HOST=localhost

# Pepper mixed into Argon2id password hashing (sec spec §2). Generate with:
#   openssl rand -hex 32
PASSWORD_PEPPER=

# 256-bit key (hex-encoded) used to envelope-encrypt TOTP secrets/backup codes (sec spec §7.2).
# Generate with:
#   openssl rand -hex 32
KMS_MASTER_KEY_HEX=

# Used only by `pnpm run seed` (apps/api, apps/portal-api) to create the first account.
# Idempotent on email — safe to leave set in a shared dev .env.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-locally
# apps/api only:
SEED_TENANT_NAME=Default Tenant

# apps/web: base URLs the Next.js app calls. NEXT_PUBLIC_* is exposed to the browser bundle —
# never put a secret in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_API_URL=http://localhost:3100