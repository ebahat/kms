# Copy to .env on the VM (never commit the filled-in version — it holds real secrets).
# docker compose reads this automatically from the same directory.

# --- Domain / registry ---
DOMAIN=bahat.co.il
REGISTRY=eu-frankfurt-1.ocir.io/axjceqpmgl6l
TAG=latest

# --- MongoDB Atlas (external, M0 free tier — EU region for PRD §3) ---
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/kms?retryWrites=true&w=majority

# --- Secrets: generate these, never reuse an example value ---
# openssl rand -hex 32
PASSWORD_PEPPER=
# openssl rand -hex 32   (64 hex chars = 32 bytes, required by LocalMasterKeyProvider)
KMS_MASTER_KEY_HEX=

# --- OCI Object Storage (from `terraform output`) ---
OCI_DATA_BUCKET=kms-kms-data
OCI_NAMESPACE=axjceqpmgl6l
OCI_REGION=eu-frankfurt-1
