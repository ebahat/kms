# Copy to .env on the VM (never commit the filled-in version — it holds real secrets).
# docker compose reads this automatically from the same directory.

# --- Domain / registry ---
DOMAIN=bahat.co.il
# OCIR hostname uses the region's short KEY (mtz for il-jerusalem-1), not the region name.
REGISTRY=mtz.ocir.io/axjceqpmgl6l
TAG=latest

# --- MongoDB Atlas (external, M0 free tier — EU region recommended for PRD §3 data residency;
# compute is in il-jerusalem-1 for latency, data-at-rest can still be EU — see ADR-0015) ---
# Variable name MUST be exactly MONGO_URI — docker-compose.yml and the app both read that name.
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/kms?retryWrites=true&w=majority

# --- Secrets: generate these, never reuse an example value ---
# openssl rand -hex 32
PASSWORD_PEPPER=
# openssl rand -hex 32   (64 hex chars = 32 bytes, required by LocalMasterKeyProvider)
KMS_MASTER_KEY_HEX=

# --- OCI Object Storage (from `terraform output`) ---
OCI_DATA_BUCKET=kms-kms-data
OCI_NAMESPACE=axjceqpmgl6l
OCI_REGION=il-jerusalem-1

# --- Vertex AI (Gemini 2.5 Flash chat + text-multilingual-embedding-002), wired 2026-08-31 ---
# GCP project with Vertex AI enabled + billing linked, and a service account (roles/aiplatform.user)
# whose JSON key is placed on the VM — see deploy/README.md's "Vertex AI credentials" section.
VERTEX_PROJECT_ID=kibo-kms
VERTEX_REGION=europe-west4
# Path to the service-account JSON key file, ON THE VM (never commit this file). Defaults to
# ./vertex-key.json (same directory as this .env) if left unset.
VERTEX_KEY_FILE=./vertex-key.json

# --- OpenAI (chat fallback, gpt-5-mini — ADR-0008 amendment 2026-08-31, replaces Claude) ---
# Used only if Vertex is unreachable/unset. Generate at platform.openai.com/api-keys.
OPENAI_API_KEY=
